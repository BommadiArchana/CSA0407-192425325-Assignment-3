
#include <stdio.h>

#define SEGMENTS 4

// Segment table containing base and limit
struct Segment
{
    int base;
    int limit;
};

int main()
{
    struct Segment table[SEGMENTS] = {
        {1000, 400},
        {2000, 500},
        {3000, 300},
        {4000, 600}
    };

    int segment, offset;
    int i;

    int addresses[8][2] = {
        {0, 100},
        {0, 350},
        {1, 200},
        {1, 550},
        {2, 150},
        {2, 350},
        {3, 500},
        {3, 700}
    };

    printf("SEGMENTATION ADDRESS TRANSLATION\n");
    printf("--------------------------------\n");

    for (i = 0; i < 8; i++)
    {
        segment = addresses[i][0];
        offset = addresses[i][1];

        printf("Segment: %d, Offset: %d -> ",
               segment, offset);

        if (segment < 0 || segment >= SEGMENTS)
        {
            printf("Invalid segment\n");
        }
        else if (offset < 0 || offset >= table[segment].limit)
        {
            printf("Segmentation Fault: Offset exceeds limit\n");
        }
        else
        {
            printf("Physical Address: %d\n",
                   table[segment].base + offset);
        }
    }

    return 0;
}
