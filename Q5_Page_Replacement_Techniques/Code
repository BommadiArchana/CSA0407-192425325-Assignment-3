
#include <stdio.h>
#include <stdlib.h>
#include <time.h>
#include <sys/resource.h>
#include <unistd.h>

#define SIZE_MB 100
#define PAGE_SIZE 4096

int main()
{
    size_t size = SIZE_MB * 1024 * 1024;
    size_t pages = size / PAGE_SIZE;

    char *memory = malloc(size);

    if (memory == NULL)
    {
        printf("Memory allocation failed.\n");
        return 1;
    }

    struct rusage before, after;

    printf("VIRTUAL MEMORY AND DEMAND PAGING\n");
    printf("--------------------------------\n");

    printf("Allocated Memory: %d MB\n", SIZE_MB);
    printf("Number of Pages: %zu\n", pages);

    // Sequential memory access
    getrusage(RUSAGE_SELF, &before);

    for (size_t i = 0; i < size; i += PAGE_SIZE)
    {
        memory[i] = 1;
    }

    getrusage(RUSAGE_SELF, &after);

    printf("\nSequential Memory Access:\n");
    printf("Minor Page Faults: %ld\n",
           after.ru_minflt - before.ru_minflt);
    printf("Major Page Faults: %ld\n",
           after.ru_majflt - before.ru_majflt);

    // Random memory access
    srand((unsigned int)time(NULL));

    getrusage(RUSAGE_SELF, &before);

    for (size_t i = 0; i < pages; i++)
    {
        size_t index = (size_t)rand() % pages;
        memory[index * PAGE_SIZE] = 2;
    }

    getrusage(RUSAGE_SELF, &after);

    printf("\nRandom Memory Access:\n");
    printf("Minor Page Faults: %ld\n",
           after.ru_minflt - before.ru_minflt);
    printf("Major Page Faults: %ld\n",
           after.ru_majflt - before.ru_majflt);

    free(memory);

    printf("\nMemory released successfully.\n");

    return 0;
}
