
#include <stdio.h>
#include <stdlib.h>
#include <time.h>

#define SIZE_MB 100
#define PAGE_SIZE 4096

int main()
{
    size_t size = SIZE_MB * 1024 * 1024;
    size_t pages = size / PAGE_SIZE;

    char *memory;
    int *page_status;

    size_t i, index;
    int sequential_faults = 0;
    int random_faults = 0;

    memory = (char *)malloc(size);
    page_status = (int *)calloc(pages, sizeof(int));

    if (memory == NULL || page_status == NULL)
    {
        printf("Memory allocation failed.\n");
        free(memory);
        free(page_status);
        return 1;
    }

    printf("VIRTUAL MEMORY AND DEMAND PAGING\n");
    printf("--------------------------------\n");

    printf("Allocated Memory: %d MB\n", SIZE_MB);
    printf("Page Size: %d Bytes\n", PAGE_SIZE);
    printf("Number of Pages: %lu\n", (unsigned long)pages);

    // Sequential memory access
    printf("\nSequential Memory Access:\n");

    for (i = 0; i < pages; i++)
    {
        index = i * PAGE_SIZE;

        memory[index] = 1;

        if (page_status[i] == 0)
        {
            sequential_faults++;
            page_status[i] = 1;
        }
    }

    printf("Page Faults: %d\n", sequential_faults);

    // Reset page status
    for (i = 0; i < pages; i++)
    {
        page_status[i] = 0;
    }

    // Random memory access
    printf("\nRandom Memory Access:\n");

    srand((unsigned int)time(NULL));

    for (i = 0; i < pages; i++)
    {
        index = (size_t)rand() % pages;

        memory[index * PAGE_SIZE] = 2;

        if (page_status[index] == 0)
        {
            random_faults++;
            page_status[index] = 1;
        }
    }

    printf("Page Faults: %d\n", random_faults);

    printf("\nMemory Access Experiment Completed.\n");

    free(memory);
    free(page_status);

    printf("Memory released successfully.\n");

    return 0;
}
